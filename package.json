{
  "author": "Md. Amzad Hossain Roni",
  "build": {
    "appId": "com.codewithroni.universaldownloader",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "filter": [
          "**/*"
        ],
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": "dmg"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "shortcutName": "Universal Downloader"
    },
    "productName": "Universal Downloader",
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "CodeWithRoni",
      "repo": "Universal-Downloader"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "Universal Downloader \u2014 video & audio downloader for YouTube",
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "vite": "^5.4.8"
  },
  "main": "electron/main.cjs",
  "name": "universal-downloader",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:electron": "ELECTRON_DEV_URL=http://localhost:1420 electron .",
    "dist": "npm run icons && electron-builder",
    "pack": "npm run icons && electron-builder --dir",
    "preview": "vite preview",
    "start": "electron .",
    "icons": "node scripts/make-icons.cjs"
  },
  "type": "module",
  "version": "1.2.0"
}